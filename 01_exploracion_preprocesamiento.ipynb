# 

# 1. Cargar librerías
import pandas as pd
import numpy as np

# 2. Cargar datos
df = pd.read_csv("../data/Viviendas_CPV_2024_SV.csv", low_memory=False)

# 3. Identificar columnas tipo string
cols_string = ['DEPTO', 'DEPTODESC', 'MUNIC', 'MUNICDESC', 'DISTO', 'DISTODESC', 'COD_PROP', 'COD_VIV']
for col in cols_string:
    df[col] = df[col].astype(str).str.strip()

# 4. Convertir columnas restantes a numéricas
cols_numeric = [c for c in df.columns if c not in cols_string]
for col in cols_numeric:
    df[col] = pd.to_numeric(df[col], errors="coerce").astype("Int64")

# 5. Limpiar valores inconsistentes
df.replace([" ", "", "NA", "N/A", "NULL", "--"], np.nan, inplace=True)

# 6. Renombrar columnas usando diccionario
dicc = pd.read_excel("../data/Diccionario bases de datos - CPV 2024 SV.xlsx", dtype=str)
dicc.columns = dicc.columns.str.lower().str.strip()
mapa = dict(zip(dicc["mnemonico"].str.strip(), dicc["etiqueta"].str.strip()))
df.rename(columns=mapa, inplace=True)

# 7. Guardar dataset limpio
df.to_csv("../output/dataset_limpio.csv", index=False)