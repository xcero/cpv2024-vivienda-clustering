

# 1. Cargar librerías
import pandas as pd
import numpy as np
from sklearn.preprocessing import StandardScaler
from sklearn.impute import SimpleImputer
from sklearn.decomposition import PCA
from sklearn.manifold import TSNE
import umap.umap_ as umap

# 2. Cargar dataset limpio
df = pd.read_csv("../output/dataset_limpio.csv")
df_50k = df.sample(50000, random_state=42)
X = df_50k.select_dtypes(include=[np.number])

# 3. Imputación y estandarización
X_imputed = SimpleImputer(strategy="median").fit_transform(X)
X_scaled = StandardScaler().fit_transform(X_imputed)

# 4. PCA para aceleración
X_pca_30 = PCA(n_components=30, random_state=42).fit_transform(X_scaled)

# 5. PCA 2D
X_pca_2 = PCA(n_components=2, random_state=42).fit_transform(X_scaled)

# 6. t-SNE
X_tsne = TSNE(n_components=2, perplexity=30, init="pca", random_state=42).fit_transform(X_pca_30)

# 7. UMAP
X_umap = umap.UMAP(n_components=2, n_neighbors=30, min_dist=0.1, random_state=42).fit_transform(X_pca_30)

# 8. Dataframe reducido
df_reducido = pd.DataFrame({
    "pca_1": X_pca_2[:, 0],
    "pca_2": X_pca_2[:, 1],
    "tsne_1": X_tsne[:, 0],
    "tsne_2": X_tsne[:, 1],
    "umap_1": X_umap[:, 0],
    "umap_2": X_umap[:, 1],
})

# 9. Guardar resultado
df_reducido.to_csv("../output/df_50k_reducido.csv", index=False)