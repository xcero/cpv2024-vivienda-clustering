#

# 1. Cargar librerías
import pandas as pd
import numpy as np
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
import matplotlib.pyplot as plt
import seaborn as sns

# 2. Cargar datos limpios
df = pd.read_csv("../output/dataset_limpio.csv")
X = df.select_dtypes(include=[np.number]).dropna()

# 3. Escalar variables
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# 4. PCA completo
pca = PCA()
X_pca = pca.fit_transform(X_scaled)

# 5. Varianza explicada
explained_var = pca.explained_variance_ratio_
cumulative_var = np.cumsum(explained_var)
n_components_95 = np.argmax(cumulative_var >= 0.95) + 1

# 6. Método Broken Stick
def broken_stick(k, n):
    return sum([1/i for i in range(k, n+1)]) / n

n = len(explained_var)
broken_stick_vals = [broken_stick(i+1, n) for i in range(n)]

# 7. Gráfico de sedimentación
plt.figure(figsize=(10,6))
plt.plot(range(1, n+1), explained_var*100, label="Varianza explicada (%)", color="red", marker="o")
plt.plot(range(1, n+1), broken_stick_vals*100, label="Broken Stick (%)", color="blue", linestyle="--")
plt.axvline(x=n_components_95, color="black", linestyle=":", label=f"95% varianza → {n_components_95} componentes")
plt.xlabel("Componentes principales")
plt.ylabel("Porcentaje de varianza")
plt.title("Gráfico de sedimentación (PCA vs Broken Stick)")
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.show()

# 8. Prueba de permutación (opcional)
def permutacion_pca(X, n_permutaciones=100):
    original_var = PCA().fit(X).explained_variance_ratio_
    permuted_vars = []
    for _ in range(n_permutaciones):
        X_perm = np.apply_along_axis(np.random.permutation, 0, X)
        var_perm = PCA().fit(X_perm).explained_variance_ratio_
        permuted_vars.append(var_perm)
    permuted_vars = np.array(permuted_vars)
    p_values = np.mean(permuted_vars >= original_var, axis=0)
    return p_values

# Ejecutar si se desea
p_values = permutacion_pca(X_scaled, n_permutaciones=100)
for i, p in enumerate(p_values[:n_components_95]):
    print(f"Componente {i+1}: p-valor = {p:.4f}")