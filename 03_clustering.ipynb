# 1. Cargar librerías
import pandas as pd
import numpy as np
from sklearn.cluster import KMeans, DBSCAN
import hdbscan

# 2. Cargar datos reducidos
df = pd.read_csv("../output/df_50k_reducido.csv")
X = df.values

# 3. KMeans
df["cluster_kmeans"] = KMeans(n_clusters=10, random_state=42).fit_predict(X)

# 4. DBSCAN
df["cluster_dbscan"] = DBSCAN(eps=0.3, min_samples=15).fit_predict(X)

# 5. HDBSCAN
df["cluster_hdbscan"] = hdbscan.HDBSCAN(min_samples=10, min_cluster_size=50).fit_predict(X)

# 6. Guardar resultados
df.to_csv("../output/df_50k_clusters.csv", index=False)